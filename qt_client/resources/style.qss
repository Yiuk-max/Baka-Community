/* 只放视觉样式（颜色/字体/边框/圆角/hover），不放尺寸和布局 —— 见 Docs/开发约束.md 第 4 条
   色值取自 web 端 frontend/reference-theme.css。 */
/*字体*/
QWidget {
    color: #dcddde;
    font-family: "Microsoft YaHei UI";
    font-size: 14px;
}
/*主窗口三栏：左侧工具栏、左侧通讯录、中间页面*/
#toolRail, #contactPanel {
    background: #121214;
}
#centerPage {
    background: #1a1a1e;
}
/*底部状态栏*/
QStatusBar {
    background: #121214;
    color: #949ba4;
}
/*去掉状态栏里每个控件旁边的竖线*/
QStatusBar::item {
    border: 0;
}
/*工具栏顶部的程序 logo 按钮*/
#railLogoButton {
    background: #222225;
    border: 0;
    border-radius: 16px;
}
/*悬停时变主题色、圆角变大*/
#railLogoButton:hover {
    background: #5865f2;
    border-radius: 24px;
}
/*工具栏：logo 下面的分隔线*/
#railDivider {
    background: #2c2c30;
    border: 0;
}
/*工具栏：社区图标的滚动区，自己不画背景，透出工具栏的底色*/
#railCommunityArea, #railCommunityList {
    background: transparent;
    border: 0;
}
/*工具栏：社区图标按钮（图标本身已经裁成圆角）*/
#railCommunityButton {
    background: transparent;
    border: 0;
    border-radius: 16px;
}
/*通讯录：搜索框*/
#contactSearch {
    background: #17171a;
    border: 1px solid #17171a;
    border-radius: 8px;
    padding: 0 10px;    /*文字离左右边框的距离*/
    color: #b5bac1;
    selection-background-color: #5a65ea;
}
#contactSearch:focus {
    border: 1px solid #5a65ea;
}
/*通讯录：“私信”小标题*/
#contactHeading {
    color: #949ba4;
    font-size: 12px;
    font-weight: 600;
}
/*通讯录：好友 / 群列表*/
#contactList {
    background: transparent;
    border: 0;
    outline: 0;
    font-size: 15px;
}
#contactList::item {
    border-radius: 8px;
    padding-left: 8px;  /*头像离行左边的距离*/
    color: #949ba4;
}
/*悬停和选中：行变亮*/
#contactList::item:hover, #contactList::item:selected {
    background: #2c2c30;
    color: #ffffff;
}
/*通讯录：列表的滚动条，细一点、和深色背景协调*/
#contactList QScrollBar:vertical {
    background: transparent;
    width: 6px;
}
#contactList QScrollBar::handle:vertical {
    background: #3a3a40;
    border-radius: 3px;
    min-height: 24px;
}
#contactList QScrollBar::add-line:vertical, #contactList QScrollBar::sub-line:vertical,
#contactList QScrollBar::add-page:vertical, #contactList QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0;
}
/*通讯录：底部账号栏*/
#accountBar {
    background: #202024;
    border: 1px solid #252529;
    border-radius: 8px;
}
#accountName {
    color: #f2f3f5;
    font-weight: 600;
}
#accountStatus {
    color: #949ba4;
    font-size: 12px;
}
/*通讯录：账号栏右侧的设置按钮（齿轮是图片 resources/icons/settings.png）*/
#accountSettingsButton {
    background: transparent;
    border: 0;
    border-radius: 4px;
}
/*悬停时底色变亮*/
#accountSettingsButton:hover {
    background: #2b2b2f;
}
/*自动登录等待窗口、通知弹窗的卡片（和登录卡片同色）*/
#loadingCard, #noticeCard {
    background: #222225;
    border: 1px solid #29292d;
    border-radius: 8px;
}
/*等待窗口下方的 “登录...” 文字*/
#loadingText {
    color: #b5bac1;
    font-size: 14px;
}
/*通知弹窗的正文*/
#noticeText {
    color: #f2f3f5;
    font-size: 14px;
}
/*转圈：灰色底圈 + 蓝色转动的弧*/
Spinner {
    qproperty-trackColor: #555965;
    qproperty-arcColor: #7d88ff;
}
/*登录背景色*/
#loginPage {
    background: transparent;
}

/*登录卡片、边框、圆角*/

/*关闭按钮（无边框窗口）*/
#closeButton {
    background: transparent;
    border: 0;
    border-radius: 4px;
    color: #949ba4;
    font-size: 18px;
}

#closeButton:hover {
    background: #2b2b2f;
    color: #f2f3f5;
}
#loginCard {
    background: #222225;
    border: 1px solid #29292d;
    border-radius: 8px;
}
/*登录标题*/
#loginTitle {
    color: #f2f3f5;
    font-size: 24px;    /*字体*/
    font-weight: 700;   /*粗细*/
}
/*登录子标题*/
#loginSubtitle {
    color: #949ba4;
    font-size: 13px;
}
/*标签*/
#fieldLabel {
    color: #b5bac1;
    font-size: 12px;
    font-weight: 600;
}
/*登录输入框*/
#loginInput {
    background: #17171a;
    border: 1px solid #29292d;
    border-radius: 4px;
    padding: 0 12px;    /*上下、左右内边距*/
    color: #f2f3f5;
    selection-background-color: #5a65ea;
}
/*焦点时*/
#loginInput:focus {
    border: 1px solid #5a65ea;
}
/*错误提示*/
#loginError {
    color: #da373c;
    font-size: 12px;
}
/*按钮*/
#primaryButton {
    background: #5a65ea;
    border: 0;
    border-radius: 4px;
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
}
/*主要操作按钮，鼠标悬浮到按钮变色*/
#primaryButton:hover {
    background: #4d55d8;
}
/*链接按钮默认样式*/
#linkButton {
    background: transparent;
    border: 0;
    color: #949ba4;
    font-size: 12.5px;
}
/*次要文字按钮，默认透明，鼠标悬停时变亮并显示下划线*/
#linkButton:hover {
    color: #f2f3f5;
    text-decoration: underline;
}
