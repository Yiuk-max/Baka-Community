/* 只放视觉样式（颜色/字体/边框/圆角/hover），不放尺寸和布局 —— 见 Docs/开发约束.md 第 4 条
   色值取自 web 端 frontend/reference-theme.css。 */
/*字体*/
QWidget {
    color: #dcddde;
    font-family: "Microsoft YaHei UI";
    font-size: 14px;
}
/*主窗口三栏：左侧工具栏、左侧通讯录、中间页面*/
#toolRail, #contactPanel {
    background: #121214;
}
#centerPage {
    background: #1a1a1e;
}
/*底部状态栏*/
QStatusBar {
    background: #121214;
    color: #949ba4;
}
/*去掉状态栏里每个控件旁边的竖线*/
QStatusBar::item {
    border: 0;
}
/*工具栏顶部的程序 logo 按钮*/
#railLogoButton {
    background: #222225;
    border: 0;
    border-radius: 16px;
}
/*悬停时变主题色、圆角变大*/
#railLogoButton:hover {
    background: #5865f2;
    border-radius: 24px;
}
/*工具栏底部的退出登录按钮*/
#railLogoutButton {
    background: transparent;
    border: 0;
    border-radius: 16px;
    color: #949ba4;
    font-size: 12px;
}
/*悬停时变红，提示这是退出*/
#railLogoutButton:hover {
    background: #da373c;
    color: #ffffff;
}
/*自动登录等待窗口、通知弹窗的卡片（和登录卡片同色）*/
#loadingCard, #noticeCard {
    background: #222225;
    border: 1px solid #29292d;
    border-radius: 8px;
}
/*等待窗口下方的 “登录...” 文字*/
#loadingText {
    color: #b5bac1;
    font-size: 14px;
}
/*通知弹窗的正文*/
#noticeText {
    color: #f2f3f5;
    font-size: 14px;
}
/*转圈：灰色底圈 + 蓝色转动的弧*/
Spinner {
    qproperty-trackColor: #555965;
    qproperty-arcColor: #7d88ff;
}
/*登录背景色*/
#loginPage {
    background: transparent;
}

/*登录卡片、边框、圆角*/

/*关闭按钮（无边框窗口）*/
#closeButton {
    background: transparent;
    border: 0;
    border-radius: 4px;
    color: #949ba4;
    font-size: 18px;
}

#closeButton:hover {
    background: #2b2b2f;
    color: #f2f3f5;
}
#loginCard {
    background: #222225;
    border: 1px solid #29292d;
    border-radius: 8px;
}
/*登录标题*/
#loginTitle {
    color: #f2f3f5;
    font-size: 24px;    /*字体*/
    font-weight: 700;   /*粗细*/
}
/*登录子标题*/
#loginSubtitle {
    color: #949ba4;
    font-size: 13px;
}
/*标签*/
#fieldLabel {
    color: #b5bac1;
    font-size: 12px;
    font-weight: 600;
}
/*登录输入框*/
#loginInput {
    background: #17171a;
    border: 1px solid #29292d;
    border-radius: 4px;
    padding: 0 12px;    /*上下、左右内边距*/
    color: #f2f3f5;
    selection-background-color: #5a65ea;
}
/*焦点时*/
#loginInput:focus {
    border: 1px solid #5a65ea;
}
/*错误提示*/
#loginError {
    color: #da373c;
    font-size: 12px;
}
/*按钮*/
#primaryButton {
    background: #5a65ea;
    border: 0;
    border-radius: 4px;
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
}
/*主要操作按钮，鼠标悬浮到按钮变色*/
#primaryButton:hover {
    background: #4d55d8;
}
/*链接按钮默认样式*/
#linkButton {
    background: transparent;
    border: 0;
    color: #949ba4;
    font-size: 12.5px;
}
/*次要文字按钮，默认透明，鼠标悬停时变亮并显示下划线*/
#linkButton:hover {
    color: #f2f3f5;
    text-decoration: underline;
}
